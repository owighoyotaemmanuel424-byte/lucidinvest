# Server-only Neon PostgreSQL connection string. Never prefix with NEXT_PUBLIC_.
# Use Neon’s pooled connection string for app runtime; keep credentials out of Git.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DBNAME?sslmode=require

# Required for signing session cookies. Generate a unique value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
